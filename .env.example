# Frontend: apenas a URL relativa do BFF. Nunca coloque tokens aqui.
VITE_BFF_BASE_URL=/bff

# BFF (mantenha em .env local/secret manager; não use VITE_)
MAG_API_HOST=https://apis.magcap.com.br
MAG_API_TOKEN_URL=https://apis.magcap.com.br/connect/token
MAG_API_CLIENT_ID=
MAG_API_CLIENT_SECRET=
# Alternativa temporária ao client secret; mantenha também somente no servidor.
MAG_API_ACCESS_TOKEN=
BFF_HOST=127.0.0.1
BFF_PORT=3001
BFF_CORS_ORIGIN=http://localhost:5173
BFF_DATABASE_PATH=./data/partner-portal.sqlite
